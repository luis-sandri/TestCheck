{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/nonconformities/escalate-overdue",
      "schedule": "0 8 * * *"
    }
  ],
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "main.py",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend",
        "path": "/:path*"
      }
    }
  ]
}
